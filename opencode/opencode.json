{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-vibeguard@git+https://github.com/inkdust2021/opencode-vibeguard",
    "opencode-dynamic-context-pruning@git+https://github.com/Opencode-DCP/opencode-dynamic-context-pruning",
    "opencode-shell-strategy@git+https://github.com/JRedeker/opencode-shell-strategy",
    "type-inject@git+https://github.com/nick-vi/type-inject",
    "opencode-notifier@git+https://github.com/mohak34/opencode-notifier"
  ],
  "provider": {
    "ollama": {
      "api": "http://localhost:11434/v1",
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "apiKey": "ollama",
        "timeout": false
      },
      "models": {
        "qwen3-coder:latest": {
          "id": "qwen3-coder:latest",
          "name": "Qwen3 Coder 30B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 65536, "output": 16384 }
        },
        "devstral-small-2:latest": {
          "id": "devstral-small-2:latest",
          "name": "Devstral Small 2 24B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 32768, "output": 8192 }
        },
        "glm-4.7-flash:latest": {
          "id": "glm-4.7-flash:latest",
          "name": "GLM-4.7 Flash",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 32768, "output": 8192 }
        },
        "gpt-oss:20b": {
          "id": "gpt-oss:20b",
          "name": "GPT-OSS 20B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": true,
          "limit": { "context": 32768, "output": 8192 }
        },
        "gemma4:26b": {
          "id": "gemma4:26b",
          "name": "Gemma 4 26B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 32768, "output": 8192 }
        },
        "gemma4:e4b": {
          "id": "gemma4:e4b",
          "name": "Gemma 4 E4B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "agent": {
    "arthur": {
      "steps": 30
    }
  }
}
