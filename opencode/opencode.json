{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-vibeguard@git+https://github.com/inkdust2021/opencode-vibeguard",
    "context-mode",
    "opencode-shell-strategy@git+https://github.com/JRedeker/opencode-shell-strategy",
    "type-inject@git+https://github.com/nick-vi/type-inject",
    "opencode-notifier@git+https://github.com/mohak34/opencode-notifier"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.example": "allow",
      "**/appsettings.Development.json": "allow",
      "**/appsettings.Example.json": "allow",
      "**/appsettings.Sample.json": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/appsettings.json": "deny",
      "**/appsettings.*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.pfx": "deny",
      "**/*.p12": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/secrets.yml": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.json": "deny",
      "**/credentials.json": "deny",
      "**/.npmrc": "deny",
      "**/.netrc": "deny",
      "**/.aws/credentials": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.example": "allow",
      "**/appsettings.Development.json": "allow",
      "**/appsettings.Example.json": "allow",
      "**/appsettings.Sample.json": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/appsettings.json": "deny",
      "**/appsettings.*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.pfx": "deny",
      "**/*.p12": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/secrets.yml": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.json": "deny",
      "**/credentials.json": "deny",
      "**/.npmrc": "deny",
      "**/.netrc": "deny",
      "**/.aws/credentials": "deny"
    },
    "grep": {
      "*": "allow",
      "**/.env.example": "allow",
      "**/appsettings.Development.json": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/appsettings.json": "deny",
      "**/appsettings.*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/secrets.yml": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.json": "deny",
      "**/credentials.json": "deny"
    },
    "bash": {
      "*": "allow",
      "*cat*.env*": "deny",
      "*cat*appsettings*": "deny",
      "*cat*secrets*": "deny",
      "*cat*credentials*": "deny",
      "*cat*id_rsa*": "deny",
      "*cat*id_ed25519*": "deny",
      "*head*.env*": "deny",
      "*tail*.env*": "deny",
      "*less*.env*": "deny",
      "*more*.env*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/Projects/*": "allow"
    },
    "glob": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow"
  },
  "provider": {
    "ollama": {
      "api": "http://localhost:11434/v1",
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "apiKey": "ollama",
        "timeout": false
      },
      "models": {
        "qwen3-coder:latest": {
          "id": "qwen3-coder:latest",
          "name": "Qwen3 Coder 30B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 98304, "output": 16384 }
        },
        "devstral-small-2:latest": {
          "id": "devstral-small-2:latest",
          "name": "Devstral Small 2 24B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 98304, "output": 16384 }
        },
        "glm-4.7-flash:latest": {
          "id": "glm-4.7-flash:latest",
          "name": "GLM-4.7 Flash",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 98304, "output": 8192 }
        },
        "gpt-oss:20b": {
          "id": "gpt-oss:20b",
          "name": "GPT-OSS 20B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": true,
          "limit": { "context": 98304, "output": 8192 }
        },
        "gemma4:26b": {
          "id": "gemma4:26b",
          "name": "Gemma 4 26B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 98304, "output": 8192 }
        },
        "gemma4:e4b": {
          "id": "gemma4:e4b",
          "name": "Gemma 4 E4B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "limit": { "context": 98304, "output": 8192 }
        }
      }
    }
  },
  "agent": {
    "arthur": {
      "steps": 60
    },
    "erwin": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow"
      }
    },
    "fire_keeper": {
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": "allow"
      }
    },
    "gandalf": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow"
      }
    },
    "levi": {
      "permission": {
        "edit": "deny"
      }
    },
    "carter": {
      "permission": {
        "edit": {
          "*": "deny",
          "docs/security/*.md": "allow",
          "security-audit/*.md": "allow"
        }
      }
    },
    "sokka": {
      "permission": {
        "edit": {
          "*": "deny",
          "docs/plans/*.md": "allow"
        }
      }
    },
    "strelok": {
      "permission": {
        "edit": "ask"
      }
    },
    "iroh": {
      "permission": {
        "edit": {
          "*": "deny",
          "**/*.md": "allow"
        }
      }
    },
    "tarnished": {
      "permission": {
        "task": "allow"
      }
    },
    "explore": {
      "disable": true
    }
  }
}
